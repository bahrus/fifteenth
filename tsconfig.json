{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"declaration": true,
		"sourceMap": false,
		"experimentalDecorators": false,
		"newLine": "LF",
		"strict": true,
		"skipLibCheck": true
	},
	"include": [
		"*.ts",
		"types/global.d.ts"
	],
	"exclude": [
		"node_modules",
		"legacy",
		"tests",
		"playwright.config.ts"
	]
}
