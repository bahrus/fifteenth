{
  "name": "fifteenth",
  "version": "0.0.2",
  "description": "The fifteenth standard - a common language for resource management across browser storage APIs",
  "homepage": "https://github.com/bahrus/fifteenth#readme",
  "bugs": {
    "url": "https://github.com/bahrus/fifteenth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/fifteenth.git"
  },
  "license": "MIT",
  "author": "Bruce B. Anderson <anderson.bruce.b@gmail.com>",
  "type": "module",
  "main": "index.js",
  "types": "index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.js"
    },
    "./get.js": {
      "types": "./get.ts",
      "default": "./get.js"
    },
    "./set.js": {
      "types": "./set.ts",
      "default": "./set.js"
    },
    "./jsonblob.js": {
      "types": "./jsonblob.ts",
      "default": "./jsonblob.js"
    },
    "./gist.js": {
      "types": "./gist.ts",
      "default": "./gist.js"
    },
    "./aliasStore.js": {
      "types": "./aliasStore.ts",
      "default": "./aliasStore.js"
    },
    "./protocolRegistry.js": {
      "types": "./protocolRegistry.ts",
      "default": "./protocolRegistry.js"
    },
    "./protocols.js": {
      "types": "./protocols.ts",
      "default": "./protocols.js"
    },
    "./ambient.js": {
      "types": "./ambient.ts",
      "default": "./ambient.js"
    },
    "./idb.js": {
      "types": "./idb.ts",
      "default": "./idb.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "npm run build && playwright test",
    "demo:jsonblob": "npm run build && node demos/jsonblob-node.mjs",
    "update": "ncu -u && npm install",
    "safari": "npx playwright wk http://localhost:8000",
    "chrome": "npx playwright cr http://localhost:8000"
  },
  "dependencies": {
    "assign-gingerly": "0.0.96"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "spa-ssi": "0.0.28",
    "@types/node": "26.5.0",
    "typescript": "7.0.2"
  }
}
